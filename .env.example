# Jev System One
JEVMODEL_API_KEY=your_api_key_here
JEV_API_KEY=
TYPESAFE_API_KEY=
JEV_API_URL=https://jevmodel.org/v1/systemone
JEV_MODEL=jev-latest
JEV_CONFIDENCE_THRESHOLD=0.70

# NepaliPaisa API base URL (no need to change this)
NEPALIPAISA_BASE_URL=https://nepalipaisa.com/api

# HTTP request timeout in seconds (must be an integer)
NEPSE_HTTP_TIMEOUT=10

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# LangSmith tracing for Jev System One model calls (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=nepse-mcp
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
